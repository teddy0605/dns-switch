# Local config for dns-switch.sh.
# Copy to local/.env and replace values with your own.

PIHOLE_IP="192.168.1.147"
VPN_DNS_1="10.0.0.53"
VPN_DNS_2="10.0.0.54"
CACHE_SIZE="10000"
MIN_CACHE_TTL="1800"

WORK_DOMAINS=(
  "corp.example.com"
  "internal.example.com"
)

BLOCKED_DOMAINS=(
  "ads.example.net"
)

TEST_HOSTS=(
  "corp.example.com"
  "google.com"
)

VPN_PORTAL="vpn.example.com"
VPN_USER="me"
VPN_SERVERCERTS=(
  "pin-sha256:REPLACE_WITH_PORTAL_PIN="
)

# Portal + gateway hostnames. They resolve via public DNS, even when they sit
# under a WORK_DOMAINS entry, because the tunnel needs them first.
VPN_BOOTSTRAP_HOSTS=(
  "vpn.example.com"
  "gw1.example.com"
)

# Gateway names for the menu bar picker. The first one is the default.
VPN_GATEWAYS=("Gateway A" "Gateway B")
